rules_version = '2';
// Regole di Dimmispensa. Da incollare in Firebase > Firestore Database > Regole (vedi GUIDA.md, passo 5).
service cloud.firestore {
  match /databases/{database}/documents {

    // Il profilo di ogni persona: lo legge e lo scrive solo lei.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Una dispensa: la vedono e la modificano solo i suoi membri.
    match /pantries/{pantryId} {
      function signedIn() { return request.auth != null; }
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }

      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow get: if isMember();
      allow list: if false;
      allow delete: if false;

      // Modifica: i membri possono tutto. Chi non è membro può fare UNA sola cosa:
      // aggiungere se stesso (serve per "Entra con un codice": il codice è l'ID della dispensa).
      allow update: if isMember() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
      );

      // I cibi dentro la dispensa.
      match /items/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/pantries/$(pantryId)).data.members;
      }
    }
  }
}
